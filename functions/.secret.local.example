# Secrets Fapshi pour l'émulateur local UNIQUEMENT.
# Copiez ce fichier en functions/.secret.local (jamais commité) et
# remplissez avec vos identifiants SANDBOX Fapshi.
#
# En production, ces valeurs sont stockées dans Google Secret Manager via :
#   firebase functions:secrets:set FAPSHI_API_USER
#   firebase functions:secrets:set FAPSHI_API_KEY
#   firebase functions:secrets:set FAPSHI_WEBHOOK_SECRET
FAPSHI_API_USER=votre_api_user_sandbox
FAPSHI_API_KEY=votre_api_key_sandbox
FAPSHI_WEBHOOK_SECRET=le_secret_que_vous_definirez_dans_le_dashboard_fapshi
